# Server-only secrets. Configure real values in Vercel; never commit them.
DATABASE_URL=
DIRECT_URL=
CRON_SECRET=
OCM_API_KEY=
# Backward-compatible alternative: OPEN_CHARGE_MAP_API_KEY=

# Public browser configuration for the Charging Advanced Markers map.
# Restrict the key to plugv.in and the Google Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Existing PlugV email reminder service.
ZOHO_SMTP_USER=
ZOHO_SMTP_APP_PASSWORD=
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
EMAIL_FROM=PlugV Support <support@plugv.in>

# Comma-separated operational alert recipients. Yahoo is the default fallback.
OPERATIONS_ALERT_EMAILS=manzoorsyed02@yahoo.com

# Keep disabled until the additive CommunityTrip table and moderation flow are tested.
COMMUNITY_RANGE_ENABLED=false
# Generate a private random secret of at least 32 characters. Never use NEXT_PUBLIC_.
COMMUNITY_RANGE_SECRET=

# Enable only after StationReport SQL setup and end-to-end testing.
# Uses COMMUNITY_RANGE_SECRET and existing ADMIN_PASSWORD; no external data ingestion.
STATION_REPORTS_ENABLED=false
